#!/usr/bin/env zsh

set -eu -o pipefail

# Derive the Z pt weights from the histograms of an existing production made
# by `bin/z_pt_weights <shapes_tag>` (tag `<shapes_tag>-for-z-pt-reweighting`).
# Further arguments are Hydra overrides, e.g. `tags.z_pt_tag=z-pt-2026-11-09`.
main () {
    local this_file="${(%):-%x}"
    local this_dir="$( cd "$( dirname "${this_file}" )" && pwd)"

    local shapes_tag="${1:-}"
    if [[ -z "${shapes_tag}" || "${shapes_tag}" == *=* ]]; then
        echo "Usage: $(basename "${this_file}") <shapes_tag> [overrides]"
        exit 1
    fi
    shift

    python3 -m xyh.process_corrections.derive_z_pt_weights \
        "tags.shapes_tag=${shapes_tag}-for-z-pt-reweighting" "${@}"
}


main "${@}"
